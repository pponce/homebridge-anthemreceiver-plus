{
  "pluginAlias": "AnthemReceiver",
  "pluginType": "platform",
  "singular": true,
  "schema": {
    "type": "object",
    "properties": {
      "Host": {
        "title": "Host",
        "type": "string",
        "required": true,
        "minLength": 1
      },
      "Port": {
        "title": "Port",
        "type": "integer",
        "required": true,
        "default": 14999,
        "maximum": 65535,
        "minimum": 1
      },
      "PanelBrightness": {
        "title": "Front Panel Brightness",
        "type": "boolean",
        "default": true,
        "required": true
      },
      "Zone1": {
        "title": "Zone 1",
        "type": "object",
        "properties": {
          "Active": {
            "title": "Enable Zone 1 Power/Input",
            "type": "boolean",
            "default": true
          },
          "Name": {
            "title": "Name:",
            "type": "string",
            "required": false,
            "placeholder": "Zone 1"
          },
          "Power": {
            "title": "Power",
            "type": "boolean",
            "default": true
          },
          "Mute": {
            "title": "Mute",
            "type": "boolean",
            "default": true
          },
          "MultipleInputs": {
            "title": "Input Selector",
            "type": "boolean",
            "default": true
          },
          "ALM": {
            "title": "Audio Listening Mode",
            "type": "boolean",
            "default": true,
            "description": ""
          },
          "ARC": {
            "title": "ARC - (Toggle ARC status for active input, ARC must be configured)",
            "type": "boolean",
            "default": true
          },
          "Volume": {
            "title": "Volume",
            "type": "boolean",
            "default": true
          },
          "DolbyPostProcessing": {
            "title": "Dolby Audio Processing",
            "type": "boolean",
            "default": true,
            "description": ""
          }
        }
      },
      "Zone2": {
        "title": "Zone 2",
        "type": "object",
        "properties": {
          "Active": {
            "title": "Enable Zone 2 Power/Input",
            "type": "boolean",
            "default": false
          },
          "Name": {
            "title": "Name:",
            "type": "string",
            "required": false,
            "placeholder": "Zone 2"
          },
          "Power": {
            "title": "Power",
            "type": "boolean",
            "default": false
          },
          "Mute": {
            "title": "Mute",
            "type": "boolean",
            "default": false
          },
          "MultipleInputs": {
            "title": "Input Selector",
            "type": "boolean",
            "default": false
          },
          "Volume": {
            "title": "Volume",
            "type": "boolean",
            "default": false
          },
          "DolbyPostProcessing": {
            "title": "Dolby Audio Processing",
            "type": "boolean",
            "default": false,
            "description": ""
          }
        }
      },
      "MaxVolumeDB": {
        "title": "Maximum volume (dB)",
        "type": "number",
        "required": false,
        "minimum": -89.5,
        "maximum": 10,
        "description": "Optional maximum dB configured on the Anthem. Receiver mapping starts at -89.5 dB. STR always maps from -96 dB to this maximum, capped at +7 dB (+7 when blank), and applies the cap to volume buttons. 0% mutes."
      }
    }
  },
  "layout": [
    {
      "title": "Anthem Receiver Plugin Configuration",
      "type": "fieldset",
      "expandable": false,
      "items": [
        {
          "type": "help",
          "helpvalue": "<em class='primary-text'> Please read: </em> <a href='https://github.com/pponce/homebridge-anthemreceiver-plus'> Anthem Receiver Plus</a>"
        },
        {
          "type": "flex",
          "flex-flow": "row wrap",
          "items": [
            "Host",
            "Port"
          ]
        },
        "PanelBrightness",
        "MaxVolumeDB"
      ]
    },
    {
      "title": "Zone 1 - Platform Accessories",
      "type": "fieldset",
      "expandable": true,
      "expanded": true,
      "items": [
        "Zone1.Power",
        "Zone1.Mute",
        "Zone1.Volume",
        "Zone1.MultipleInputs",
        "Zone1.ALM",
        "Zone1.ARC",
        "Zone1.DolbyPostProcessing"
      ]
    },
    {
      "title": "Zone 1 - Power/Input Accessory",
      "type": "fieldset",
      "expandable": true,
      "expanded": true,
      "items": [
        {
          "type": "help",
          "helpvalue": "<em class='primary-text'>External HomeKit Televison Accessory to be manually added in Home App</em>"
        },
        "Zone1.Active",
        "Zone1.Name"
      ]
    },
    {
      "title": "Zone 2 - Platform Accessories",
      "type": "fieldset",
      "expandable": true,
      "items": [
        "Zone2.Power",
        "Zone2.Mute",
        "Zone2.Volume",
        "Zone2.MultipleInputs",
        "Zone2.DolbyPostProcessing"
      ]
    },
    {
      "title": "Zone 2 - Power/Input Accessory",
      "type": "fieldset",
      "expandable": true,
      "items": [
        {
          "type": "help",
          "helpvalue": "<em class='primary-text'>External HomeKit Televison Accessory to be manually added in Home App</em>"
        },
        "Zone2.Active",
        "Zone2.Name"
      ]
    }
  ],
  "customUi": true,
  "customUiPath": "homebridge-ui"
}
