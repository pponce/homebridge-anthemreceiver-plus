{
  "displayName": "Anthem Receiver Plus",
  "name": "homebridge-anthemreceiver-plus",
  "version": "1.0.0-beta.1",
  "description": "Maintained Anthem receiver integration with HomeKit volume mapping, confirmed controls, and a modern settings UI.",
  "author": "Pedro Ponce de Leon",
  "homepage": "https://github.com/pponce/homebridge-anthemreceiver-plus#readme",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pponce/homebridge-anthemreceiver-plus.git"
  },
  "bugs": {
    "url": "https://github.com/pponce/homebridge-anthemreceiver-plus/issues"
  },
  "engines": {
    "homebridge": "^1.8.0 || ^2.0.0",
    "node": "^22.0.0 || ^24.0.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "lint": "tsc --noEmit && node scripts/check-source.cjs",
    "watch": "npm run build && npm link && nodemon",
    "build": "node scripts/build.cjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm run lint && npm test && npm run check:package",
    "test": "npm run build && node --test test/*.test.cjs",
    "test:ui": "node --test test/ui.browser.cjs",
    "test:migration": "node scripts/check-migration.cjs",
    "check:package": "node scripts/check-package.cjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "homebridge-plugin",
    "supports-hap"
  ],
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.2.6"
  },
  "peerDependencies": {
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "nodemon": "^3.1.9",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "playwright": "^1.56.1"
  },
  "files": [
    "dist",
    "homebridge-ui",
    "config.schema.json",
    "README.md",
    "CHANGELOG.md",
    "MIGRATION.md",
    "ACKNOWLEDGEMENTS.md",
    "LICENSE"
  ]
}
